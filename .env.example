VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Public origin for canonical URLs, Open Graph, Twitter cards, and JSON-LD.
# Set VITE_SITE_URL to the production domain before launch.

# Never place service-role or database secrets in frontend env files.
# Do not add SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, POSTGRES_PASSWORD, or JWT_SECRET here.
