VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Public origin for canonical URLs, Open Graph, Twitter cards, JSON-LD, and production auth links.
VITE_SITE_URL=https://rawa-j.com

# Keep disabled until the reviewed SYP denomination migration is applied and verified
# in the target database. Enable with 1, then rebuild the web or Android client.
VITE_RAWAJ_SYP_DENOMINATION_SCHEMA=0

# Server-only, comma/newline-separated SHA-256 fingerprints from the Play App Signing
# certificate. Leave empty until the real release fingerprint is copied from Play Console.
# This value is public association metadata, but it must never use a debug certificate in Production.
RAWAJ_ANDROID_SHA256_CERT_FINGERPRINTS=

# Never place service-role or database secrets in frontend env files.
# Do not add SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, POSTGRES_PASSWORD, or JWT_SECRET here.
