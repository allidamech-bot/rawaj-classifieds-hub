# Public application data, uploads, and marketplace APIs are served by Cloudflare.
VITE_PUBLIC_DATA_PROVIDER=cloudflare
VITE_PUBLIC_DATA_API_BASE_URL=https://rawaj-classifieds-hub.allidamech.workers.dev

# Public origin for canonical URLs, Open Graph, Twitter cards, JSON-LD, and production auth links.
VITE_SITE_URL=https://rawa-j.com

# Supabase Auth is the sole identity provider. These are public client values only.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Never add service-role, secret, JWT-secret, database, or storage credentials.

# Server-only, comma/newline-separated SHA-256 fingerprints from the Play App Signing
# certificate. Leave empty until the real release fingerprint is copied from Play Console.
# This value is public association metadata, but it must never use a debug certificate in Production.
RAWAJ_ANDROID_SHA256_CERT_FINGERPRINTS=
