{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run typecheck && node --test scripts/listing-media-no-inset.test.mjs && npm run build",
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://rawaj-classifieds-hub.allidamech.workers.dev/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://rawaj-classifieds-hub.allidamech.workers.dev/api/:path*"
    }
  ]
}
