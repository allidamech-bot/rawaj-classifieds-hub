{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rawaj-classifieds-hub",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  }
}
