# Read-only legacy source. Keep the service key local and never expose it to Vite/browser code.
SUPABASE_DATABASE_URL=postgresql://readonly-user:password@host:5432/postgres
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-locally

# Optional output location for the read-only snapshot exporter.
RAWAJ_SNAPSHOT_DIR=cloudflare/snapshots/latest
