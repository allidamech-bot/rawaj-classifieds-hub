{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rawaj-classifieds-hub",
  "main": "src/entry.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "API_ALLOWED_ORIGINS": "https://rawa-j.com,https://www.rawa-j.com",
    "API_CACHE_SECONDS": "60",
    "MEDIA_CACHE_SECONDS": "86400",
    "SUPABASE_AUTH_ISSUER": "https://dpymopdckflnpmowhlyq.supabase.co/auth/v1",
    "SUPABASE_AUTH_AUDIENCE": "authenticated",
  },
}
