{
  "name": "rawaj-market-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "build": "npm run build:worker && npm run build:vercel",
    "build:worker": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/index.js --log-level=warning",
    "build:vercel": "esbuild api/gateway.ts --bundle --format=esm --platform=node --target=node22 --outfile=dist/vercel-gateway.js --log-level=warning",
    "check": "npm run types && npm run typecheck && npm test && npm run build && node --check dist/index.js && node --check dist/vercel-gateway.js",
    "release:gate": "node scripts/release-gate.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "wrangler": "4.118.0"
  }
}
